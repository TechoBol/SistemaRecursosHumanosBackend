generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractType {
  INDEFINITE
  CONSULTING
}

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  GENERATED
  APPROVED
  PAID
  CANCELLED
}

enum EmployeeDocumentType {
  RESUME
  IDENTITY_DOCUMENT
  CONTRACT
  CERTIFICATE
  OTHER
}

enum MemorandumType {
  POSITIVE
  NEGATIVE
}

enum AttendanceIncidentType {
  PERMISSION
  ABSENCE
  LATENESS
}

enum AttendanceDurationType {
  HOURS
  HALF_DAY
  FULL_DAY
}

enum EmployeeMovementType {
  BONUS
  DISCOUNT
  ADVANCE
}

enum EmployeeMovementStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum TerminationType {
  RESIGNATION
  DISMISSAL
  CONTRACT_END
  MUTUAL_AGREEMENT
  OTHER
}

enum AdvanceType {
  SALARY
  DEBT
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  legalName String?  @map("legal_name") @db.VarChar(180)
  taxId     String?  @unique @map("tax_id") @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches                      CompanyBranch[]
  contractualEmployeeContracts  EmployeeContract[] @relation("ContractCompany")
  consolidatedEmployeeContracts EmployeeContract[] @relation("ConsolidatedCompany")
  contractualEmployeePayrolls   EmployeePayroll[]  @relation("PayrollContractCompany")
  consolidatedEmployeePayrolls  EmployeePayroll[]  @relation("PayrollConsolidatedCompany")

  @@map("companies")
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches Branch[]

  @@map("cities")
}

model Branch {
  id          Int      @id @default(autoincrement())
  cityId      Int      @map("city_id")
  name        String   @db.VarChar(120)
  description String?  @db.Text
  address     String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  city      City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  companies CompanyBranch[]
  contracts EmployeeContract[]

  @@map("branches")
}

model CompanyBranch {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  branchId  Int      @map("branch_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([companyId, branchId])
  @@index([branchId])
  @@map("company_branches")
}

model Area {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  jobTitles AreaJobTitle[]
  contracts EmployeeContract[]

  @@map("areas")
}

model JobTitle {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  areas                AreaJobTitle[]
  actualContracts      EmployeeContract[] @relation("ActualJobTitle")
  contractualContracts EmployeeContract[] @relation("ContractJobTitle")

  @@map("job_titles")
}

model AreaJobTitle {
  id         Int      @id @default(autoincrement())
  areaId     Int      @map("area_id")
  jobTitleId Int      @map("job_title_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  area     Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)

  @@unique([areaId, jobTitleId])
  @@index([areaId])
  @@index([jobTitleId])
  @@map("area_job_titles")
}

model User {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  firstName    String    @default("") @map("first_name") @db.VarChar(100)
  lastName     String    @default("") @map("last_name") @db.VarChar(100)
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastAccessAt DateTime? @map("last_access_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  role                   Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  generatedPayrolls      EmployeePayroll[]
  createdMemorandums     Memorandum[]
  registeredTerminations Termination[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(80)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  users User[]

  @@map("roles")
}

model Employee {
  id             Int            @id @default(autoincrement())
  firstNames     String         @map("first_names") @db.VarChar(120)
  lastNames      String         @map("last_names") @db.VarChar(160)
  documentNumber String         @unique @map("document_number") @db.VarChar(30)
  birthDate      DateTime?      @map("birth_date") @db.Date
  phone          String?        @db.VarChar(30)
  email          String?        @unique @db.VarChar(150)
  address        String?        @db.VarChar(255)
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  contracts         EmployeeContract[]
  emergencyContacts EmergencyContact[]
  documents         EmployeeDocument[]
  memorandums       Memorandum[]
  incidents         AttendanceIncident[]
  vacations         Vacation[]
  advances          EmployeeAdvance[]
  movements         EmployeeMovement[]
  payrolls          EmployeePayroll[]
  terminations      Termination[]

  @@index([status])
  @@map("employees")
}

model EmployeeContract {
  id                    Int            @id @default(autoincrement())
  employeeId            Int            @map("employee_id")
  contractCompanyId     Int            @map("contract_company_id")
  contractJobTitleId    Int?           @map("contract_job_title_id")
  consolidatedCompanyId Int            @map("consolidated_company_id")
  branchId              Int            @map("branch_id")
  areaId                Int            @map("area_id")
  jobTitleId            Int            @map("job_title_id")
  contractType          ContractType   @map("contract_type")
  hireDate              DateTime       @map("hire_date") @db.Date
  endDate               DateTime?      @map("end_date") @db.Date
  baseSalary            Decimal        @map("base_salary") @db.Decimal(12, 2)
  status                ContractStatus @default(ACTIVE)
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractCompany     Company   @relation("ContractCompany", fields: [contractCompanyId], references: [id], onDelete: Restrict)
  consolidatedCompany Company   @relation("ConsolidatedCompany", fields: [consolidatedCompanyId], references: [id], onDelete: Restrict)
  branch              Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  area                Area      @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jobTitle            JobTitle  @relation("ActualJobTitle", fields: [jobTitleId], references: [id], onDelete: Restrict)
  contractJobTitle    JobTitle? @relation("ContractJobTitle", fields: [contractJobTitleId], references: [id], onDelete: Restrict)

  terminations Termination[]

  @@index([employeeId])
  @@index([employeeId, isActive])
  @@index([contractCompanyId])
  @@index([contractJobTitleId])
  @@index([consolidatedCompanyId])
  @@index([branchId])
  @@index([areaId])
  @@index([jobTitleId])
  @@index([status])
  @@map("employee_contracts")
}

model EmergencyContact {
  id           Int      @id @default(autoincrement())
  employeeId   Int      @map("employee_id")
  fullName     String   @map("full_name") @db.VarChar(160)
  relationship String   @db.VarChar(60)
  phone        String   @db.VarChar(30)
  address      String?  @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

model EmployeeDocument {
  id           Int                  @id @default(autoincrement())
  employeeId   Int                  @map("employee_id")
  documentType EmployeeDocumentType @map("document_type")
  name         String               @db.VarChar(180)
  fileUrl      String               @map("file_url") @db.VarChar(500)
  documentDate DateTime?            @map("document_date") @db.Date
  notes        String?              @db.Text
  uploadedAt   DateTime             @default(now()) @map("uploaded_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([documentType])
  @@map("employee_documents")
}

model Memorandum {
  id             Int            @id @default(autoincrement())
  employeeId     Int            @map("employee_id")
  createdById    Int            @map("created_by_id")
  type           MemorandumType
  title          String         @db.VarChar(180)
  category       String?        @db.VarChar(100)
  memorandumDate DateTime       @map("memorandum_date") @db.Date
  description    String         @db.Text
  fileUrl        String?        @map("file_url") @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([createdById])
  @@index([type])
  @@map("memorandums")
}

model AttendanceIncident {
  id            Int                    @id @default(autoincrement())
  employeeId    Int                    @map("employee_id")
  type          AttendanceIncidentType
  durationType  AttendanceDurationType @map("duration_type")
  incidentDate  DateTime               @map("incident_date") @db.Date
  reason        String?                @db.VarChar(180)
  description   String?                @db.Text
  discount      Decimal                @default(0) @map("discount") @db.Decimal(10, 2)
  registeredBy  String                 @map("registered_by") @db.VarChar(120)
  attachmentUrl String?                @map("attachment_url") @db.VarChar(500)
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([incidentDate])
  @@index([type])
  @@map("attendance_incidents")
}

model Vacation {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime @map("end_date") @db.Date
  days       Decimal  @db.Decimal(5, 2)
  status     String   @default("REQUESTED") @db.VarChar(20)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([startDate])
  @@index([status])
  @@map("vacations")
}

// Aticipos
model EmployeeAdvance {
  id           Int         @id @default(autoincrement())
  employeeId   Int         @map("employee_id")
  type         AdvanceType @default(SALARY)
  amount       Decimal     @db.Decimal(12, 2)
  advanceDate  DateTime    @map("advance_date") @db.Date
  notes        String?     @db.Text
  registeredBy String      @map("registered_by") @db.VarChar(120)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([advanceDate])
  @@map("employee_advances")
}

model EmployeeMovement {
  id           Int                    @id @default(autoincrement())
  employeeId   Int                    @map("employee_id")
  type         EmployeeMovementType
  amount       Decimal                @db.Decimal(12, 2)
  movementDate DateTime               @map("movement_date") @db.Date
  description  String?                @db.Text
  status       EmployeeMovementStatus @default(PENDING)
  appliedYear  Int?                   @map("applied_year")
  appliedMonth Int?                   @map("applied_month")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([type])
  @@index([status])
  @@index([appliedYear, appliedMonth])
  @@map("employee_movements")
}

model EmployeePayroll {
  id                    Int           @id @default(autoincrement())
  employeeId            Int           @map("employee_id")
  contractCompanyId     Int           @map("contract_company_id")
  consolidatedCompanyId Int           @map("consolidated_company_id")
  generatedById         Int           @map("generated_by_id")
  year                  Int
  month                 Int
  baseSalary            Decimal       @map("base_salary") @db.Decimal(12, 2)
  workedDays            Decimal       @default(30) @map("worked_days") @db.Decimal(5, 2)
  earnedSalary          Decimal       @map("earned_salary") @db.Decimal(12, 2)
  seniorityBonus        Decimal       @default(0) @map("seniority_bonus") @db.Decimal(12, 2)
  otherBonuses          Decimal       @default(0) @map("other_bonuses") @db.Decimal(12, 2)
  discounts             Decimal       @default(0) @db.Decimal(12, 2)
  advances              Decimal       @default(0) @db.Decimal(12, 2)
  afpDeduction          Decimal       @default(0) @map("afp_deduction") @db.Decimal(12, 2)
  otherDeductions       Decimal       @default(0) @map("other_deductions") @db.Decimal(12, 2)
  totalEarnings         Decimal       @map("total_earnings") @db.Decimal(12, 2)
  totalDeductions       Decimal       @map("total_deductions") @db.Decimal(12, 2)
  netSalary             Decimal       @map("net_salary") @db.Decimal(12, 2)
  status                PayrollStatus @default(DRAFT)
  generatedAt           DateTime      @default(now()) @map("generated_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractCompany     Company  @relation("PayrollContractCompany", fields: [contractCompanyId], references: [id], onDelete: Restrict)
  consolidatedCompany Company  @relation("PayrollConsolidatedCompany", fields: [consolidatedCompanyId], references: [id], onDelete: Restrict)
  generatedBy         User     @relation(fields: [generatedById], references: [id], onDelete: Restrict)

  @@unique([employeeId, year, month])
  @@index([contractCompanyId, year, month])
  @@index([consolidatedCompanyId, year, month])
  @@index([status])
  @@map("employee_payrolls")
}

model Termination {
  id                 Int             @id @default(autoincrement())
  employeeId         Int             @map("employee_id")
  contractId         Int             @map("contract_id")
  registeredByUserId Int             @map("registered_by_user_id")
  type               TerminationType
  terminationDate    DateTime        @map("termination_date") @db.Date
  reason             String?         @db.VarChar(180)
  description        String?         @db.Text
  settlementAmount   Decimal?        @map("settlement_amount") @db.Decimal(12, 2)
  documentUrl        String?         @map("document_url") @db.VarChar(500)
  createdAt          DateTime        @default(now()) @map("created_at")

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract         EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  registeredByUser User             @relation(fields: [registeredByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([contractId])
  @@index([registeredByUserId])
  @@map("terminations")
}
