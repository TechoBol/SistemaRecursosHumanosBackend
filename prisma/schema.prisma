generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// ENUMS
// ======================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PayrollPeriodStatus {
  OPEN
  PROCESSED
  CLOSED
}

enum PayrollCriteria {
  CONTRACTING_COMPANY
  CONSOLIDATED_COMPANY
}

enum PayrollStatus {
  DRAFT
  GENERATED
  APPROVED
  CLOSED
  CANCELLED
}

enum PayrollConceptType {
  EARNING
  DEDUCTION
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkIncidentCategory {
  PERMISSION
  ABSENCE
  DELAY
  LEAVE
  SICK_LEAVE
}

enum WorkIncidentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MemorandumStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum SalaryAdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum SalaryAdvanceInstallmentStatus {
  PENDING
  DEDUCTED
  PAID
  CANCELLED
}

enum SalaryEventCategory {
  EARNING
  DEDUCTION
}

enum SalaryEventStatus {
  PENDING
  APPLIED
  CANCELLED
}

// ======================================================
// COMPANIES
// ======================================================

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  legalName String?  @map("legal_name") @db.VarChar(180)
  taxId     String?  @unique @map("tax_id") @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branches          CompanyBranch[]
  areas             CompanyArea[]
  jobTitles         CompanyJobTitle[]
  employeeContracts EmployeeContract[]
  workAssignments   WorkAssignment[]
  payrolls          Payroll[]

  @@map("companies")
}

// ======================================================
// BRANCHES
// ======================================================

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  state     String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  companies       CompanyBranch[]
  workAssignments WorkAssignment[]

  @@unique([name, state, address])
  @@map("branches")
}

model CompanyBranch {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  branchId  Int      @map("branch_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([companyId, branchId])
  @@index([branchId])
  @@map("company_branches")
}

// ======================================================
// AREAS
// ======================================================

model Area {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  companies       CompanyArea[]
  workAssignments WorkAssignment[]

  @@map("areas")
}

model CompanyArea {
  id        Int      @id @default(autoincrement())
  companyId Int      @map("company_id")
  areaId    Int      @map("area_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  area    Area    @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([companyId, areaId])
  @@index([areaId])
  @@map("company_areas")
}

// ======================================================
// JOB TITLES
// ======================================================

model JobTitle {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(150)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  companies       CompanyJobTitle[]
  workAssignments WorkAssignment[]

  @@map("job_titles")
}

model CompanyJobTitle {
  id         Int      @id @default(autoincrement())
  companyId  Int      @map("company_id")
  jobTitleId Int      @map("job_title_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)

  @@unique([companyId, jobTitleId])
  @@index([jobTitleId])
  @@map("company_job_titles")
}

// ======================================================
// EMPLOYEES
// ======================================================

model Employee {
  id             Int            @id @default(autoincrement())
  firstNames     String         @map("first_names") @db.VarChar(120)
  lastNames      String         @map("last_names") @db.VarChar(160)
  documentNumber String         @unique @map("document_number") @db.VarChar(30)
  birthDate      DateTime?      @map("birth_date") @db.Date
  phone          String?        @db.VarChar(30)
  email          String?        @unique @db.VarChar(150)
  address        String?        @db.VarChar(255)
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  emergencyContacts EmergencyContact[]
  contracts         EmployeeContract[]
  workAssignments   WorkAssignment[]
  salaryHistory     SalaryHistory[]
  payrollDetails    PayrollDetail[]
  vacationBalances  VacationBalance[]
  vacationRequests  VacationRequest[]  @relation("EmployeeVacationRequests")

  approvedVacationRequests VacationRequest[] @relation("VacationRequestApprover")

  workIncidents         WorkIncident[] @relation("EmployeeWorkIncidents")
  approvedWorkIncidents WorkIncident[] @relation("WorkIncidentApprover")

  receivedMemorandums Memorandum[] @relation("MemorandumRecipient")
  issuedMemorandums   Memorandum[] @relation("MemorandumIssuer")

  salaryAdvances         SalaryAdvance[] @relation("EmployeeSalaryAdvances")
  approvedSalaryAdvances SalaryAdvance[] @relation("SalaryAdvanceApprover")

  salaryEvents SalaryEvent[]
  terminations Termination[]

  @@index([status])
  @@map("employees")
}

// ======================================================
// EMERGENCY CONTACTS
// ======================================================

model EmergencyContact {
  id             Int      @id @default(autoincrement())
  employeeId     Int      @map("employee_id")
  fullName       String   @map("full_name") @db.VarChar(160)
  relationship   String   @db.VarChar(60)
  phone          String   @db.VarChar(30)
  secondaryPhone String?  @map("secondary_phone") @db.VarChar(30)
  address        String?  @db.VarChar(255)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("emergency_contacts")
}

// ======================================================
// CONTRACT TYPES
// ======================================================

model ContractType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employeeContracts EmployeeContract[]

  @@map("contract_types")
}

// ======================================================
// EMPLOYEE CONTRACTS
// ======================================================

model EmployeeContract {
  id                   Int            @id @default(autoincrement())
  employeeId           Int            @map("employee_id")
  contractingCompanyId Int            @map("contracting_company_id")
  contractTypeId       Int            @map("contract_type_id")
  startDate            DateTime       @map("start_date") @db.Date
  endDate              DateTime?      @map("end_date") @db.Date
  status               ContractStatus @default(ACTIVE)
  documentUrl          String?        @map("document_url") @db.VarChar(500)
  notes                String?        @db.Text
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contractingCompany Company      @relation(fields: [contractingCompanyId], references: [id], onDelete: Restrict)
  contractType       ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Restrict)

  salaryHistory  SalaryHistory[]
  payrollDetails PayrollDetail[]
  terminations   Termination[]

  @@index([employeeId])
  @@index([contractingCompanyId, status])
  @@index([contractTypeId])
  @@map("employee_contracts")
}

// ======================================================
// WORK ASSIGNMENTS
// ======================================================

model WorkAssignment {
  id                    Int       @id @default(autoincrement())
  employeeId            Int       @map("employee_id")
  consolidatedCompanyId Int       @map("consolidated_company_id")
  branchId              Int       @map("branch_id")
  areaId                Int       @map("area_id")
  jobTitleId            Int       @map("job_title_id")
  startDate             DateTime  @map("start_date") @db.Date
  endDate               DateTime? @map("end_date") @db.Date
  isCurrent             Boolean   @default(true) @map("is_current")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  consolidatedCompany Company  @relation(fields: [consolidatedCompanyId], references: [id], onDelete: Restrict)
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  area                Area     @relation(fields: [areaId], references: [id], onDelete: Restrict)
  jobTitle            JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)

  payrollDetails PayrollDetail[]

  @@index([employeeId, isCurrent])
  @@index([consolidatedCompanyId, isCurrent])
  @@index([branchId])
  @@index([areaId])
  @@index([jobTitleId])
  @@map("work_assignments")
}

// ======================================================
// SALARY HISTORY
// ======================================================

model SalaryHistory {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  contractId   Int       @map("contract_id")
  baseSalary   Decimal   @map("base_salary") @db.Decimal(12, 2)
  currency     String    @default("BOB") @db.VarChar(10)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isCurrent    Boolean   @default(true) @map("is_current")
  changeReason String?   @map("change_reason") @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([employeeId, isCurrent])
  @@index([contractId])
  @@map("salary_history")
}

// ======================================================
// USERS AND ROLES
// ======================================================

model User {
  id           Int       @id @default(autoincrement())
  roleId       Int       @map("role_id")
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(150)
  password     String    @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastAccessAt DateTime? @map("last_access_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  role                   Role          @relation(fields: [roleId], references: [id], onDelete: Restrict)
  generatedPayrolls      Payroll[]
  registeredTerminations Termination[]

  @@index([roleId])
  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(80)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

// ======================================================
// PAYROLL PERIODS
// ======================================================

model PayrollPeriod {
  id        Int                 @id @default(autoincrement())
  year      Int
  month     Int
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    PayrollPeriodStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  payrolls                  Payroll[]
  salaryAdvanceInstallments SalaryAdvanceInstallment[]
  salaryEvents              SalaryEvent[]

  @@unique([year, month])
  @@map("payroll_periods")
}

// ======================================================
// PAYROLLS
// ======================================================

model Payroll {
  id                Int             @id @default(autoincrement())
  payrollPeriodId   Int             @map("payroll_period_id")
  companyId         Int             @map("company_id")
  criteria          PayrollCriteria
  status            PayrollStatus   @default(DRAFT)
  generatedByUserId Int             @map("generated_by_user_id")
  generatedAt       DateTime        @default(now()) @map("generated_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  payrollPeriod   PayrollPeriod   @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  generatedByUser User            @relation(fields: [generatedByUserId], references: [id], onDelete: Restrict)
  details         PayrollDetail[]

  @@unique([payrollPeriodId, companyId, criteria])
  @@index([companyId, criteria])
  @@index([generatedByUserId])
  @@map("payrolls")
}

model PayrollDetail {
  id               Int      @id @default(autoincrement())
  payrollId        Int      @map("payroll_id")
  employeeId       Int      @map("employee_id")
  contractId       Int      @map("contract_id")
  workAssignmentId Int      @map("work_assignment_id")
  baseSalary       Decimal  @map("base_salary") @db.Decimal(12, 2)
  workedDays       Decimal  @default(0) @map("worked_days") @db.Decimal(5, 2)
  totalEarnings    Decimal  @default(0) @map("total_earnings") @db.Decimal(12, 2)
  totalDeductions  Decimal  @default(0) @map("total_deductions") @db.Decimal(12, 2)
  netPay           Decimal  @default(0) @map("net_pay") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payroll        Payroll                @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee       Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract       EmployeeContract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  workAssignment WorkAssignment         @relation(fields: [workAssignmentId], references: [id], onDelete: Restrict)
  concepts       PayrollDetailConcept[]

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@index([contractId])
  @@index([workAssignmentId])
  @@map("payroll_details")
}

// ======================================================
// PAYROLL CONCEPTS
// ======================================================

model PayrollConcept {
  id          Int                @id @default(autoincrement())
  name        String             @unique @db.VarChar(120)
  type        PayrollConceptType
  description String?            @db.Text
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  payrollDetails PayrollDetailConcept[]

  @@map("payroll_concepts")
}

model PayrollDetailConcept {
  id               Int      @id @default(autoincrement())
  payrollDetailId  Int      @map("payroll_detail_id")
  payrollConceptId Int      @map("payroll_concept_id")
  amount           Decimal  @db.Decimal(12, 2)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payrollDetail  PayrollDetail  @relation(fields: [payrollDetailId], references: [id], onDelete: Cascade)
  payrollConcept PayrollConcept @relation(fields: [payrollConceptId], references: [id], onDelete: Restrict)

  @@unique([payrollDetailId, payrollConceptId])
  @@index([payrollConceptId])
  @@map("payroll_detail_concepts")
}

// ======================================================
// VACATIONS
// ======================================================

model VacationBalance {
  id            Int      @id @default(autoincrement())
  employeeId    Int      @map("employee_id")
  year          Int
  assignedDays  Decimal  @default(0) @map("assigned_days") @db.Decimal(5, 2)
  usedDays      Decimal  @default(0) @map("used_days") @db.Decimal(5, 2)
  availableDays Decimal  @default(0) @map("available_days") @db.Decimal(5, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("vacation_balances")
}

model VacationRequest {
  id                   Int           @id @default(autoincrement())
  employeeId           Int           @map("employee_id")
  startDate            DateTime      @map("start_date") @db.Date
  endDate              DateTime      @map("end_date") @db.Date
  numberOfDays         Decimal       @map("number_of_days") @db.Decimal(5, 2)
  reason               String?       @db.Text
  status               RequestStatus @default(PENDING)
  approvedByEmployeeId Int?          @map("approved_by_employee_id")
  responseDate         DateTime?     @map("response_date")
  responseNotes        String?       @map("response_notes") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  employee           Employee  @relation("EmployeeVacationRequests", fields: [employeeId], references: [id], onDelete: Restrict)
  approvedByEmployee Employee? @relation("VacationRequestApprover", fields: [approvedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([approvedByEmployeeId])
  @@map("vacation_requests")
}

// ======================================================
// WORK INCIDENTS
// ======================================================

model WorkIncidentType {
  id               Int                  @id @default(autoincrement())
  name             String               @unique @db.VarChar(100)
  category         WorkIncidentCategory
  deductsSalary    Boolean              @default(false) @map("deducts_salary")
  requiresApproval Boolean              @default(true) @map("requires_approval")
  isActive         Boolean              @default(true) @map("is_active")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  workIncidents WorkIncident[]

  @@map("work_incident_types")
}

model WorkIncident {
  id                   Int                @id @default(autoincrement())
  employeeId           Int                @map("employee_id")
  workIncidentTypeId   Int                @map("work_incident_type_id")
  startDate            DateTime           @map("start_date")
  endDate              DateTime?          @map("end_date")
  numberOfHours        Decimal?           @map("number_of_hours") @db.Decimal(6, 2)
  numberOfDays         Decimal?           @map("number_of_days") @db.Decimal(5, 2)
  reason               String?            @db.Text
  status               WorkIncidentStatus @default(PENDING)
  deductionAmount      Decimal?           @map("deduction_amount") @db.Decimal(12, 2)
  approvedByEmployeeId Int?               @map("approved_by_employee_id")
  documentUrl          String?            @map("document_url") @db.VarChar(500)
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  employee           Employee         @relation("EmployeeWorkIncidents", fields: [employeeId], references: [id], onDelete: Restrict)
  workIncidentType   WorkIncidentType @relation(fields: [workIncidentTypeId], references: [id], onDelete: Restrict)
  approvedByEmployee Employee?        @relation("WorkIncidentApprover", fields: [approvedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([workIncidentTypeId])
  @@index([approvedByEmployeeId])
  @@map("work_incidents")
}

// ======================================================
// MEMORANDUMS
// ======================================================

model MemorandumType {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memorandums Memorandum[]

  @@map("memorandum_types")
}

model Memorandum {
  id                 Int              @id @default(autoincrement())
  employeeId         Int              @map("employee_id")
  memorandumTypeId   Int              @map("memorandum_type_id")
  issueDate          DateTime         @map("issue_date") @db.Date
  subject            String           @db.VarChar(200)
  content            String           @db.Text
  issuedByEmployeeId Int?             @map("issued_by_employee_id")
  documentUrl        String?          @map("document_url") @db.VarChar(500)
  status             MemorandumStatus @default(ISSUED)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  employee         Employee       @relation("MemorandumRecipient", fields: [employeeId], references: [id], onDelete: Restrict)
  memorandumType   MemorandumType @relation(fields: [memorandumTypeId], references: [id], onDelete: Restrict)
  issuedByEmployee Employee?      @relation("MemorandumIssuer", fields: [issuedByEmployeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([memorandumTypeId])
  @@index([issuedByEmployeeId])
  @@map("memorandums")
}

// ======================================================
// SALARY ADVANCES
// ======================================================

model SalaryAdvance {
  id                   Int                 @id @default(autoincrement())
  employeeId           Int                 @map("employee_id")
  requestDate          DateTime            @map("request_date") @db.Date
  requestedAmount      Decimal             @map("requested_amount") @db.Decimal(12, 2)
  approvedAmount       Decimal?            @map("approved_amount") @db.Decimal(12, 2)
  numberOfInstallments Int?                @map("number_of_installments")
  reason               String?             @db.Text
  status               SalaryAdvanceStatus @default(PENDING)
  approvedByEmployeeId Int?                @map("approved_by_employee_id")
  approvalDate         DateTime?           @map("approval_date") @db.Date
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  employee           Employee                   @relation("EmployeeSalaryAdvances", fields: [employeeId], references: [id], onDelete: Restrict)
  approvedByEmployee Employee?                  @relation("SalaryAdvanceApprover", fields: [approvedByEmployeeId], references: [id], onDelete: SetNull)
  installments       SalaryAdvanceInstallment[]

  @@index([employeeId, status])
  @@index([approvedByEmployeeId])
  @@map("salary_advances")
}

model SalaryAdvanceInstallment {
  id                Int                            @id @default(autoincrement())
  salaryAdvanceId   Int                            @map("salary_advance_id")
  payrollPeriodId   Int?                           @map("payroll_period_id")
  installmentNumber Int                            @map("installment_number")
  amount            Decimal                        @db.Decimal(12, 2)
  status            SalaryAdvanceInstallmentStatus @default(PENDING)
  paymentDate       DateTime?                      @map("payment_date") @db.Date
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")

  salaryAdvance SalaryAdvance  @relation(fields: [salaryAdvanceId], references: [id], onDelete: Cascade)
  payrollPeriod PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)

  @@unique([salaryAdvanceId, installmentNumber])
  @@index([payrollPeriodId])
  @@map("salary_advance_installments")
}

// ======================================================
// SALARY EVENTS
// ======================================================

model SalaryEventType {
  id        Int                 @id @default(autoincrement())
  name      String              @unique @db.VarChar(120)
  category  SalaryEventCategory
  isActive  Boolean             @default(true) @map("is_active")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  salaryEvents SalaryEvent[]

  @@map("salary_event_types")
}

model SalaryEvent {
  id                Int               @id @default(autoincrement())
  employeeId        Int               @map("employee_id")
  salaryEventTypeId Int               @map("salary_event_type_id")
  payrollPeriodId   Int?              @map("payroll_period_id")
  eventDate         DateTime          @map("event_date") @db.Date
  amount            Decimal           @db.Decimal(12, 2)
  description       String?           @db.Text
  status            SalaryEventStatus @default(PENDING)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salaryEventType SalaryEventType @relation(fields: [salaryEventTypeId], references: [id], onDelete: Restrict)
  payrollPeriod   PayrollPeriod?  @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([salaryEventTypeId])
  @@index([payrollPeriodId])
  @@map("salary_events")
}

// ======================================================
// TERMINATIONS
// ======================================================

model Termination {
  id                 Int      @id @default(autoincrement())
  employeeId         Int      @map("employee_id")
  contractId         Int      @map("contract_id")
  terminationDate    DateTime @map("termination_date") @db.Date
  terminationType    String   @map("termination_type") @db.VarChar(60)
  reason             String   @db.Text
  notes              String?  @db.Text
  documentUrl        String?  @map("document_url") @db.VarChar(500)
  registeredByUserId Int      @map("registered_by_user_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  contract         EmployeeContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  registeredByUser User             @relation(fields: [registeredByUserId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([contractId])
  @@index([registeredByUserId])
  @@map("terminations")
}
